# Settings for deploying access-control-ui to the "dev" environment.
# Used by bin/deploy.sh (make build-image / make deploy ENV=dev).
# Replace every <FILL_ME> value; the script refuses to run while any are left.

# Google Cloud project that runs the Cloud Run service and holds the image repository.
PROJECT_ID="ent-data-ingestion-dev"
# Its project number: gcloud projects describe <PROJECT_ID> --format='value(projectNumber)'
PROJECT_NUMBER="591606789673"
REGION="us-central1"
# Artifact Registry repository (Docker format): just its name, e.g. "access-control-ui".
# A full path like "us-central1-docker.pkg.dev/<project>/<repo>" also works.
REPO="us-central1-docker.pkg.dev/${PROJECT_ID}/edp/access-control-ui"

IMAGE_NAME="access-control-ui"
SERVICE_NAME="access-control-ui"
# The app's own identity. It may edit only the access-control dataset (see README).
#SERVICE_ACCOUNT="access-control-ui@${PROJECT_ID}.iam.gserviceaccount.com"
SERVICE_ACCOUNT="sa-cloudrun-schema-loader-dev@ent-data-ingestion-dev.iam.gserviceaccount.com"

# Where the access-control tables live.
BQ_PROJECT="ent-data-warehouse-dev"
BQ_DATASET="roller_analytics_agent_access_control"

# Optional, comma-separated. Empty = everyone allowed through IAP is an admin.
ADMIN_EMAILS=""
