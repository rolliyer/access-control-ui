# Keep the build context small and free of local state.
.git
.claude
.vscode
deploy
Dockerfile
.dockerignore
README.md

# Frontend build output and dependencies (rebuilt inside the image)
frontend/node_modules
frontend/dist
frontend/coverage
**/*.local
**/.env.*.local
**/npm-debug.log*
**/.eslintcache

# Backend virtualenv and caches
backend/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
backend/tests
