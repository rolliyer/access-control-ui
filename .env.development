# mock = data kept in the browser (seeded from dev_seed.sql); http = call the REST backend
VITE_API_MODE=mock
# Base URL of the access-control REST API (used when VITE_API_MODE=http)
VITE_API_BASE_URL=/api
# Admin email the mock backend records as created_by / revoked_by
VITE_ACTOR_EMAIL=admin@rollerdigital.com
